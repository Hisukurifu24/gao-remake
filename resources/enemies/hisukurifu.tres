[sub_resource type="Resource" id="game_master"]
script = ExtResource("phase")
display_name = "Hisukurifu, Game Master"
form = SubResource("gm_form")
skills = Array[ExtResource("skill")]([ExtResource("patch_notes"), ExtResource("hotfix"), ExtResource("system_call")])
skill_bias = 0.6
attack_scale = 1.05
defense_scale = 1.0
speed_scale = 1.0
lines = PackedStringArray("Hm. You actually broke a bar. Most people's playtests end about here.", "Fine. I'll drop the paladin act.", "This is the avatar I log in as when something is broken. Game Master. It has permissions you don't.")
speaker = "Hisukurifu"
portrait = ExtResource("gm_face")

[sub_resource type="Resource" id="developer"]
script = ExtResource("phase")
display_name = "Hisukurifu, the Developer"
form = SubResource("dev_form")
skills = Array[ExtResource("skill")]([ExtResource("delete_key"), ExtResource("segfault")])
skill_bias = 0.6
attack_scale = 1.15
defense_scale = 1.05
speed_scale = 1.0
lines = PackedStringArray("No more avatars, then. This is me.", "Your world seed is {seed}. Every floor under your feet grew out of that one number. The rest I built by hand, one table at a time.", "And every time I changed a number, a test fought me hundreds of times to make sure you could still win. It said you could.", "Let's find out if it was right.")
speaker = "Hisukurifu"
portrait = ExtResource("dev_face")
music = &"revelation"

[sub_resource type="Resource" id="not_responding"]
script = ExtResource("phase")
display_name = "hisukurifu.exe (Not Responding)"
form = SubResource("exe_form")
attack_scale = 1.15
defense_scale = 0.75
speed_scale = 1.2
narration = PackedStringArray("Hisukurifu's texture fails to load.")
lines = PackedStringArray("...That isn't supposed to happen. Ignore it. I'm still the final boss.", "You've spent {time} in my world, {player}. Let me make the last minute count.")
speaker = "Hisukurifu"
portrait = ExtResource("exe_face")
buff = ExtResource("hasted")

