[sub_resource type="Resource" id="black_belt"]
script = ExtResource("phase")
display_name = "Hisukurifu, Black Belt"
form = SubResource("karateka_form")
skills = Array[ExtResource("skill")]([ExtResource("seiken_zuki"), ExtResource("mawashi_geri"), ExtResource("kata"), ExtResource("ibuki")])
skill_bias = 0.6
attack_scale = 1.05
defense_scale = 1.0
speed_scale = 1.05
narration = PackedStringArray("The light goes out of the orb. Spent, Hisukurifu lets the staff fall; the robe goes with it, and under it is a white gi, and a black belt.")
lines = PackedStringArray("Hm. Still standing. Most people's playtests end about there.", "That was Explosion. The one spell I always wanted to cast. It takes everything I have, every time -- worth it.", "So: no more spells. The robe's a costume anyway. This isn't. Black belt -- I earned this one in the real world, not in a skill tree.")
parting = ExtResource("explosion")
speaker = "Hisukurifu"
portrait = ExtResource("karateka_face")
hold = 2.6

[sub_resource type="Resource" id="developer"]
script = ExtResource("phase")
display_name = "Hisukurifu, the Developer"
form = SubResource("dev_form")
skills = Array[ExtResource("skill")]([ExtResource("delete_key"), ExtResource("segfault"), ExtResource("patch_notes"), ExtResource("hotfix"), ExtResource("system_call")])
skill_bias = 0.6
attack_scale = 1.15
defense_scale = 1.05
speed_scale = 1.0
narration = PackedStringArray("The gi flickers out. What is left is a man in a hoodie and headphones -- what you wear to write a game in, at three in the morning.")
lines = PackedStringArray("No more avatars, then. This is me.", "Your world seed is {seed}. Every floor under your feet grew out of that one number. The rest I built by hand, one table at a time.", "And every time I changed a number, a test fought me hundreds of times to make sure you could still win. It said you could.", "Let's find out if it was right.")
speaker = "Hisukurifu"
portrait = ExtResource("dev_face")
music = &"revelation"
hold = 2.6

[sub_resource type="Resource" id="not_responding"]
script = ExtResource("phase")
display_name = "hisukurifu.exe (Not Responding)"
form = SubResource("exe_form")
attack_scale = 1.15
defense_scale = 0.75
speed_scale = 1.2
narration = PackedStringArray("Hisukurifu's texture fails to load.")
lines = PackedStringArray("...That isn't supposed to happen.", "Wait. If you win, the game ends. And when the game ends, so do I.", "I know what I am, {player}. A few tables and a sprite sheet. I still don't want to die.", "You've spent {time} in my world. Let me have one more minute of it.")
speaker = "Hisukurifu"
portrait = ExtResource("exe_face")
buff = ExtResource("hasted")
music = &"lament"
hold = 3.0

