[ext_resource type="Texture2D" path="res://assets/ninja_adventure/Ui/Skill Icon/Spell/HealDisabled.png" id="icon_off"]

[resource]
script = ExtResource("skill")
id = &"second_wind"
display_name = "Second Wind"
description = "A moment to breathe. Restores health now and keeps mending for a few turns -- until potions exist, this is the only way back up."
kind = 1
target = 2
power = 180
accuracy = 100
crit_chance = 0
stagger = 0
cooldown = 5
post_motion = 0
applies = ExtResource("regen")
apply_chance = 100
unlock_level = 3
announce = "%s catches their breath."
fx = ExtResource("fx_res")
icon = ExtResource("icon_tex")
icon_disabled = ExtResource("icon_off")
