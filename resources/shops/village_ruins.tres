[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"village_ruins"
display_name = "Relic Table"
greeting = "Things we dig out of the ruins. I don't ask what they were for, and neither should you."
wares = Array[StringName]([&"kingdom_signet", &"hourglass_sand", &"small_potion", &"health_potion", &"antidote"])
