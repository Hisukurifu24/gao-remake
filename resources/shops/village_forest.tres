[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"village_forest"
display_name = "Trapper's Lodge"
greeting = "Wolf pelts, and the tonic the loggers drink before they go into the pines."
wares = Array[StringName]([&"wolfskin_cloak", &"bark_tonic", &"small_potion", &"health_potion", &"antidote"])
