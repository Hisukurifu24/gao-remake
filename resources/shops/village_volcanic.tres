[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"village_volcanic"
display_name = "Emberforge"
greeting = "Blades from the drakes' fire, and scrolls that carry a little of it."
wares = Array[StringName]([&"emberforged_blade", &"ember_scroll", &"small_potion", &"health_potion", &"antidote"])
