[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"village_ice"
display_name = "Furrier's"
greeting = "Snowfur from the golem country, and fish off the ice. You'll want both up here."
wares = Array[StringName]([&"snowfur_mantle", &"smoked_char", &"small_potion", &"health_potion", &"antidote"])
