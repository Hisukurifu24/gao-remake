[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"travelling_merchant"
display_name = "Peddler's Pack"
keeper = "The peddler"
greeting = "Fire's free. Potions aren't -- but they're what they cost in town, and town's a long walk back."
wares = Array[StringName]([&"small_potion", &"health_potion", &"antidote", &"whetstone"])
