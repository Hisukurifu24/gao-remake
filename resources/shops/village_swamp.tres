[gd_resource type="Resource" script_class="Shop" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop.gd" id="shop"]

[resource]
script = ExtResource("shop")
id = &"village_swamp"
display_name = "Stilt-Hut Trader"
greeting = "Lizardhide and remedies. The bog takes, so we sell what it gives back."
wares = Array[StringName]([&"lizardhide_vest", &"marsh_remedy", &"small_potion", &"health_potion", &"antidote"])
